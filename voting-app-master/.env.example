NODE_ENV=development
PORT=3005
MONGO_URI=mongodb://localhost:27017/voting-app

JWT_SECRET=your-secret-key-here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=SecureVote

REDIS_URL=redis://localhost:6379

# For local dev use http://localhost:5173
# For production on Render, use your Netlify URL (comma-separated for multiple)
# Example: CLIENT_URL=https://votting-system.netlify.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
